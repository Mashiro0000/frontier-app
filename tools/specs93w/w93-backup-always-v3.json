{
  "label": "w93-backup-always-v3",
  "edits": [
    {
      "file": "{{REPO}}/src/main/backup.ts",
      "from": "  JSON.stringify({ version: fileVersion(chat), ...chat })",
      "to": "  JSON.stringify({ version: 3, ...chat })"
    }
  ],
  "argv": [
    "{{TOOLS}}/run93.mjs",
    "dev"
  ],
  "env": {
    "NO_RETRY": "1",
    "RUN93_ONLY": "w"
  },
  "timeoutMs": 600000
}

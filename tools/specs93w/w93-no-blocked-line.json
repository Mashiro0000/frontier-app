{
  "label": "w93-no-blocked-line",
  "edits": [
    {
      "file": "{{REPO}}/src/renderer/src/chat/Composer.tsx",
      "from": "      {blocked !== null && (",
      "to": "      {false && ("
    }
  ],
  "argv": [
    "{{TOOLS}}/run93.mjs",
    "dev"
  ],
  "env": {
    "NO_RETRY": "1",
    "RUN93_ONLY": "c"
  },
  "timeoutMs": 600000
}

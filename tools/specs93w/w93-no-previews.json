{
  "label": "w93-no-previews",
  "edits": [
    {
      "file": "{{REPO}}/src/renderer/src/chat/ChatView.tsx",
      "from": "      <PreviewsContext.Provider value={previews}>",
      "to": "      <PreviewsContext.Provider value={new Map()}>"
    }
  ],
  "argv": [
    "{{TOOLS}}/run93.mjs",
    "dev"
  ],
  "env": {
    "NO_RETRY": "1",
    "RUN93_ONLY": "w"
  },
  "timeoutMs": 600000
}

{
  "label": "w176-wPdfTyped",
  "edits": [
    {
      "file": "{{REPO}}/src/main/providers/gemini.ts",
      "from": "          ? { inlineData: { mimeType: 'application/pdf', data: file.data } }",
      "to": "          ? { inlineData: { mimeType: 'application/octet-stream', data: file.data } }"
    }
  ],
  "argv": [
    "{{TOOLS}}/run176.mjs",
    "dev"
  ],
  "env": {
    "NO_RETRY": "1"
  },
  "timeoutMs": 1200000
}

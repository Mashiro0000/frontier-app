    {
      "file": "{{REPO}}/src/main/backupDialogs.ts",
      "from": "    filters: [ANY_FILTER],",
      "to": "    filters: [ANY_FILTER, { name: 'Images', extensions: ['png', 'jpg'] }],"
    }
  ],
  "argv": [
    "{{TOOLS}}/run92.mjs",
    "dev"
  ],
  "env": {
    "NO_RETRY": "1"
  },
  "timeoutMs": 420000
}

{
  "label": "w114-stop-not-told",
  "edits": [
    {
      "file": "{{REPO}}/src/renderer/src/App.tsx",
      "from": "toolsOn={anyToolOn(toolSettings.status, toolSettings.workspace)}",
      "to": "toolsOn={false}"
    }
  ],
  "argv": [
    "{{TOOLS}}/run114.mjs",
    "dev"
  ],
  "env": {
    "NO_RETRY": "1"
  },
  "timeoutMs": 600000
}

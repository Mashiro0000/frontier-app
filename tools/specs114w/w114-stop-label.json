{
  "label": "w114-stop-label",
  "edits": [
    {
      "file": "{{REPO}}/src/renderer/src/chat/Composer.tsx",
      "from": "{stopEverything ? 'Stop everything' : 'Stop'}",
      "to": "{`Stop`}"
    }
  ],
  "argv": [
    "{{TOOLS}}/run114.mjs",
    "dev"
  ],
  "env": {
    "NO_RETRY": "1"
  },
  "timeoutMs": 600000
}

{
  "label": "w123-wNoteTool",
  "edits": [
    {
      "file": "{{REPO}}/src/renderer/src/chat/ToolNote.tsx",
      "from": "{noteOutcomeText(note.outcome, live, note.tool)}",
      "to": "{noteOutcomeText(note.outcome, live)}"
    }
  ],
  "argv": [
    "{{TOOLS}}/run123.mjs",
    "dev"
  ],
  "env": {
    "NO_RETRY": "1"
  },
  "timeoutMs": 600000
}

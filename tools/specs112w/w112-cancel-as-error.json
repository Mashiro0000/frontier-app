{
  "label": "w112-cancel-as-error",
  "edits": [
    {
      "file": "{{REPO}}/src/renderer/src/tools/ToolsDialog.tsx",
      "from": "setNotice({ kind: result.cancelled ? 'ok' : 'error', text: result.error })",
      "to": "setNotice({ kind: 'error', text: result.error })"
    }
  ],
  "argv": [
    "{{TOOLS}}/run112.mjs",
    "dev"
  ],
  "env": {
    "NO_RETRY": "1"
  },
  "timeoutMs": 600000
}

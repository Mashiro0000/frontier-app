{
  "label": "w112-button-busy",
  "edits": [
    {
      "file": "{{REPO}}/src/renderer/src/sidebar/Sidebar.tsx",
      "from": "              disabled={isReplying}\n              title={isReplying ? page.wait",
      "to": "              disabled={isReplying && id !== 'tools'}\n              title={isReplying ? page.wait"
    }
  ],
  "argv": [
    "{{TOOLS}}/run112.mjs",
    "dev"
  ],
  "env": {
    "NO_RETRY": "1"
  },
  "timeoutMs": 600000
}

{
  "label": "w94-text-only",
  "edits": [
    {
      "file": "{{REPO}}/src/main/chat.ts",
      "from": "      estimateInputTokens(streamRequest.system, streamRequest.messages) +\n      fileTokens +\n",
      "to": "      estimateInputTokens(streamRequest.system, streamRequest.messages) +\n"
    }
  ],
  "argv": [
    "{{TOOLS}}/run94.mjs",
    "dev"
  ],
  "env": {
    "NO_RETRY": "1"
  },
  "timeoutMs": 400000
}

{
  "label": "w113-record",
  "edits": [
    {
      "file": "{{REPO}}/src/main/ipc.ts",
      "from": "    record: (event) => auditLog.append(event),",
      "to": "    record: async () => undefined,"
    }
  ],
  "argv": [
    "{{TOOLS}}/run113.mjs",
    "dev"
  ],
  "env": {
    "NO_RETRY": "1"
  },
  "timeoutMs": 900000
}
